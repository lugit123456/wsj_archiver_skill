# OpenAI-compatible LLM
LLM_API_KEY=sk-
LLM_BASE_URL=
LLM_MODEL=gpt-5.4-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_S=180
CRAWL_MAX_RETRIES=2

# WSJ eReader preview
WSJ_EREADER_TIMEOUT_S=30
CRAWL_DELAY_MIN_S=2
CRAWL_DELAY_MAX_S=4

# Dedicated Chromium profile and local cookie backup
BROWSER_USER_DATA_PATH=
BROWSER_HEADLESS=false
WSJ_COOKIE_PATH=
BROWSER_MANUAL_LOGIN_TIMEOUT_S=900

# Translation pipeline
LLM_COMPILE_WORKERS=2
LLM_MAX_PENDING=4
LLM_GLOSSARY_ENABLED=true
LLM_GLOSSARY_MODEL=
LLM_GLOSSARY_MAX_TERMS=32
LLM_GLOSSARY_MAX_ZH_CANDIDATES=32
LLM_GLOSSARY_MAX_INPUT_CHARS=24000
LLM_GLOSSARY_MAX_TOKENS=5000
LLM_GLOSSARY_MAX_RETRIES=2

# Optional output overrides
OUTPUT_ROOT=
DATABASE_JS_PATH=
INDEX_HTML_PATH=
INDEX_HTML_TEMPLATE=
ARTICLE_MD_DIR=
